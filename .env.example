# Application runtime
NODE_ENV=development
PORT=3000
APP_PROVIDER=freegen

# Freegen provider settings
# Required for real image generation requests.
FREEGEN_API_URL=https://api.example.com/v1/generate
# Optional depending on your Freegen plan.
FREEGEN_API_KEY=
FREEGEN_TIMEOUT_MS=60000
FREEGEN_DEFAULT_SIZE=1024x1024
FREEGEN_DEFAULT_STEPS=30
FREEGEN_DEFAULT_CFG=7

# Local output directories (relative to repository root)
OUTPUT_IMAGE_DIR=outputs/images
OUTPUT_METADATA_DIR=outputs/metadata
OUTPUT_VIDEO_DIR=outputs/videos
OUTPUT_VIDEO_RUN_DIR=outputs/video-runs

# Prompt and retry behavior
ENABLE_PROMPT_LOGGING=true
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=800

# Video pipeline rendering defaults
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_WORDS_PER_MINUTE=135

# Optional TurboScribe API integration for automatic transcription
TURBOSCRIBE_API_URL=
TURBOSCRIBE_API_KEY=

# Optional autopublish controls
AUTO_PUBLISH=false

# YouTube upload (OAuth access token required)
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=

# Facebook page upload
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# Instagram Reels publish (requires publicly accessible video URL)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VIDEO_PUBLIC_URL=

# Optional generic webhook fan-out (comma-separated URLs)
SOCIAL_WEBHOOK_URLS=
